# Codex-UI local configuration. Copy this file to .env.
# Never commit .env, private keys, service-role keys, or payment secrets.

# Optional: Supabase public client configuration for desktop login.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Add codexui://auth/callback to your Supabase redirect allow list.

# Optional: URL of your own deployed commerce backend.
VITE_COMMERCE_API_URL=https://your-deployment.example.com

# Server-side only (Vercel Functions or another trusted backend).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional legacy HS256 validation path. Prefer Supabase Auth/JWKS when possible.
SUPABASE_JWT_SECRET=

# Optional Alipay server configuration. Never expose these values to VITE_* variables.
ALIPAY_APP_ID=your-app-id
ALIPAY_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
ALIPAY_SELLER_ID=your-seller-id
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# Public URL of the deployed commerce API, used for server-side callbacks.
COMMERCE_API_URL=https://your-deployment.example.com
